APP_NAME=Ezyweb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ezyweb.test
APP_DOMAIN=ezyweb.in
APP_MARKETING_DOMAIN=www.ezyweb.in
APP_DASHBOARD_DOMAIN=app.ezyweb.in
APP_ADMIN_DOMAIN=admin.ezyweb.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
SLOW_REQUEST_THRESHOLD_MS=1500
SLOW_QUERY_THRESHOLD_MS=500

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ezyweb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CLOUD_FILESYSTEM_DISK=gcs
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
GOOGLE_CLOUD_STORAGE_API_URI=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MEDIA_DISK=local
MEDIA_MAX_UPLOAD_KB=10240
MEDIA_MAX_DIMENSION=12000
MEDIA_STORAGE_LIMIT_MB=1024
MEDIA_WEBP_QUALITY=84

SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=true
CSP_REPORT_URI=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
READINESS_CHECK_DATABASE=true
READINESS_CHECK_CACHE=true

SUPER_ADMIN_NAME="Ezyweb Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ezyweb.in"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
