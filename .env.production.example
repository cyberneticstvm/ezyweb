APP_NAME=Ezyweb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ezyweb.in
APP_DOMAIN=ezyweb.in
APP_MARKETING_DOMAIN=www.ezyweb.in
APP_DASHBOARD_DOMAIN=app.ezyweb.in
APP_ADMIN_DOMAIN=admin.ezyweb.in
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
SLOW_REQUEST_THRESHOLD_MS=1500
SLOW_QUERY_THRESHOLD_MS=500

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ezyweb
DB_USERNAME=ezyweb
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.ezyweb.in

FILESYSTEM_DISK=local
CLOUD_FILESYSTEM_DISK=gcs
MEDIA_DISK=gcs
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=/etc/ezyweb/gcs-service-account.json
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=media

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@ezyweb.in
MAIL_FROM_NAME=Ezyweb

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
READINESS_CHECK_DATABASE=true
READINESS_CHECK_CACHE=true

SUPER_ADMIN_NAME="Ezyweb Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
